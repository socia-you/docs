{
  "username": "notes",
  "name": "Notes",
  "version": "0.1.3",
  "entry": "index.html",
  "ui": {
    "fullscreen": false,
    "showHeader": false,
    "tabbar": {
      "enabled": true,
      "defaultTab": "home",
      "showBack": true,
      "showSettings": true,
      "style": {
        "background": "#202020",
        "borderColor": "rgba(232,228,222,0.14)",
        "borderWidth": 1.5,
        "borderRadius": 18,
        "activeColor": "#fbbf24",
        "inactiveColor": "rgba(232,228,222,0.48)",
        "shadow": "hard"
      },
      "tabs": [
        {
          "id": "home",
          "icon": "home",
          "label": "Notes"
        },
        {
          "id": "profile",
          "icon": "user",
          "label": "Profile"
        }
      ]
    }
  },
  "permissions": [
    "network"
  ],
  "backend": {
    "base_url": "https://backend.socia.you",
    "allowed_paths": [
      "/api/users/me",
      "/api/wallet/me"
    ],
    "allowed_methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "timeout_sec": 15
  }
}
